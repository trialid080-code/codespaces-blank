class MainActivity : ComponentActivity() {

    private lateinit var cameraManager: CameraManager

    private lateinit var cameraThread: HandlerThread
    private lateinit var cameraHandler: Handler

    private var cameraDevice: CameraDevice? = null
    private var captureSession: CameraCaptureSession? = null

    private var previewSurface: Surface? = null
    private var imageReader: ImageReader? = null

    private var textureView: TextureView? = null

    private var isOpeningCamera = false

    private var status by mutableStateOf("Starting camera...")

    private val cameraPermissionLauncher =
        registerForActivityResult(
            ActivityResultContracts.RequestPermission()
        ) { granted ->

            if (granted) {
                textureView?.let {
                    if (it.isAvailable) {
                        openCamera(it)
                    }
                }
            } else {
                status = "Camera permission denied"
            }
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        cameraManager =
            getSystemService(Context.CAMERA_SERVICE) as CameraManager

        cameraThread = HandlerThread("AstroPadCameraThread")
        cameraThread.start()

        cameraHandler = Handler(cameraThread.looper)

        setContent {

            MaterialTheme {

                AstroPadCameraScreen(
                    status = status,

                    onTextureViewReady = { view ->

                        textureView = view

                        if (view.isAvailable) {
                            checkPermissionAndOpen(view)
                        }
                    },

                    onCapture = {
                        capturePhoto()
                    }
                )
            }
        }
    }

    private fun checkPermissionAndOpen(view: TextureView) {

        if (
            checkSelfPermission(
                Manifest.permission.CAMERA
            ) != PackageManager.PERMISSION_GRANTED
        ) {

            cameraPermissionLauncher.launch(
                Manifest.permission.CAMERA
            )

            return
        }

        openCamera(view)
    }

    private fun openCamera(view: TextureView) {

        if (cameraDevice != null || isOpeningCamera) {
            return
        }

        if (!view.isAvailable) {
            status = "Preview surface not ready"
            return
        }

        isOpeningCamera = true

        status = "Opening Camera 0..."

        try {

            val cameraId = "0"

            val characteristics =
                cameraManager.getCameraCharacteristics(cameraId)

            val map =
                characteristics.get(
                    android.hardware.camera2.CameraCharacteristics
                        .SCALER_STREAM_CONFIGURATION_MAP
                )

            if (map == null) {

                status = "ERROR: No stream configuration"

                isOpeningCamera = false

                return
            }

            val previewSizes =
                map.getOutputSizes(
                    SurfaceTexture::class.java
                )

            if (previewSizes == null || previewSizes.isEmpty()) {

                status = "ERROR: No TextureView sizes"

                isOpeningCamera = false

                return
            }

            val largestPreview =
                previewSizes.maxByOrNull {
                    it.width.toLong() * it.height.toLong()
                }

            status =
                "Camera supported. Preview: " +
                "${largestPreview?.width}×${largestPreview?.height}"

            cameraManager.openCamera(
                cameraId,

                object : CameraDevice.StateCallback() {

                    override fun onOpened(
                        camera: CameraDevice
                    ) {

                        isOpeningCamera = false

                        cameraDevice = camera

                        status = "Camera opened"

                        setupOutputs(view)
                    }

                    override fun onDisconnected(
                        camera: CameraDevice
                    ) {

                        isOpeningCamera = false

                        camera.close()

                        cameraDevice = null

                        status = "Camera disconnected"
                    }

                    override fun onError(
                        camera: CameraDevice,
                        error: Int
                    ) {

                        isOpeningCamera = false

                        camera.close()

                        cameraDevice = null

                        status =
                            "Camera ERROR code: $error"
                    }
                },

                cameraHandler
            )

        } catch (e: Exception) {

            isOpeningCamera = false

            status =
                "OPEN ERROR: ${e.javaClass.simpleName}"

            e.printStackTrace()
        }
    }

    private fun setupOutputs(view: TextureView) {

        val camera = cameraDevice ?: return

        val texture =
            view.surfaceTexture ?: run {

                status = "ERROR: SurfaceTexture unavailable"

                return
            }

        try {

            val characteristics =
                cameraManager.getCameraCharacteristics("0")

            val map =
                characteristics.get(
                    android.hardware.camera2.CameraCharacteristics
                        .SCALER_STREAM_CONFIGURATION_MAP
                ) ?: run {

                    status = "ERROR: Stream map unavailable"

                    return
                }

            val previewSizes =
                map.getOutputSizes(
                    SurfaceTexture::class.java
                )

            if (previewSizes.isNullOrEmpty()) {

                status = "ERROR: No preview sizes"

                return
            }

            /*
             * Use a camera-supported 4:3-ish preview size.
             * We deliberately don't use TextureView's arbitrary
             * screen size because Camera2 requires supported
             * output configurations.
             */

            val previewSize =
                previewSizes
                    .filter {
                        it.width >= 640 &&
                        it.height >= 480
                    }
                    .minByOrNull {
                        kotlin.math.abs(
                            (it.width.toFloat() / it.height) -
                            (4f / 3f)
                        )
                    }
                    ?: previewSizes[0]

            texture.setDefaultBufferSize(
                previewSize.width,
                previewSize.height
            )

            previewSurface?.release()

            previewSurface = Surface(texture)

            /*
             * JPEG ImageReader.
             *
             * We choose a supported JPEG size instead of
             * assuming that every resolution is valid.
             */

            val jpegSizes =
                map.getOutputSizes(ImageFormat.JPEG)

            if (jpegSizes.isNullOrEmpty()) {

                status = "ERROR: JPEG not supported"

                return
            }

            val jpegSize =
                jpegSizes.maxByOrNull {
                    it.width.toLong() * it.height.toLong()
                } ?: jpegSizes[0]

            imageReader?.close()

            imageReader =
                ImageReader.newInstance(
                    jpegSize.width,
                    jpegSize.height,
                    ImageFormat.JPEG,
                    2
                )

            imageReader?.setOnImageAvailableListener(
                { reader ->

                    val image = reader.acquireLatestImage()
                        ?: return@setOnImageAvailableListener

                    try {

                        val buffer =
                            image.planes[0].buffer

                        val bytes =
                            ByteArray(buffer.remaining())

                        buffer.get(bytes)

                        saveJpeg(bytes)

                    } catch (e: Exception) {

                        status =
                            "SAVE ERROR: ${e.javaClass.simpleName}"

                    } finally {

                        image.close()
                    }

                },
                cameraHandler
            )

            val preview =
                previewSurface ?: return

            val jpegSurface =
                imageReader?.surface ?: return

            camera.createCaptureSession(
                listOf(
                    preview,
                    jpegSurface
                ),

                object :
                    CameraCaptureSession.StateCallback() {

                    override fun onConfigured(
                        session: CameraCaptureSession
                    ) {

                        captureSession = session

                        try {

                            val builder =
                                camera.createCaptureRequest(
                                    CameraDevice.TEMPLATE_PREVIEW
                                )

                            builder.addTarget(preview)

                            builder.set(
                                CaptureRequest.CONTROL_MODE,
                                CaptureRequest.CONTROL_MODE_AUTO
                            )

                            session.setRepeatingRequest(
                                builder.build(),
                                object :
                                    CameraCaptureSession.CaptureCallback() {

                                    override fun onCaptureCompleted(
                                        session: CameraCaptureSession,
                                        request: CaptureRequest,
                                        result: android.hardware.camera2.TotalCaptureResult
                                    ) {

                                        status =
                                            "Preview running"
                                    }
                                },
                                cameraHandler
                            )

                        } catch (e: Exception) {

                            status =
                                "PREVIEW ERROR: " +
                                e.javaClass.simpleName

                            e.printStackTrace()
                        }
                    }

                    override fun onConfigureFailed(
                        session: CameraCaptureSession
                    ) {

                        captureSession = null

                        status =
                            "ERROR: Camera session configuration failed"
                    }
                },

                cameraHandler
            )

        } catch (e: Exception) {

            status =
                "SETUP ERROR: ${e.javaClass.simpleName}"

            e.printStackTrace()
        }
    }

    private fun capturePhoto() {

        val camera = cameraDevice
        val session = captureSession
        val reader = imageReader

        if (camera == null) {

            status = "Capture failed: camera not open"

            return
        }

        if (session == null) {

            status = "Capture failed: session not ready"

            return
        }

        if (reader == null) {

            status = "Capture failed: ImageReader unavailable"

            return
        }

        try {

            val builder =
                camera.createCaptureRequest(
                    CameraDevice.TEMPLATE_STILL_CAPTURE
                )

            builder.addTarget(reader.surface)

            builder.set(
                CaptureRequest.CONTROL_MODE,
                CaptureRequest.CONTROL_MODE_AUTO
            )

            status = "Capturing..."

            session.capture(
                builder.build(),

                object :
                    CameraCaptureSession.CaptureCallback() {

                    override fun onCaptureCompleted(
                        session: CameraCaptureSession,
                        request: CaptureRequest,
                        result: android.hardware.camera2.TotalCaptureResult
                    ) {

                        status = "Captured — saving..."
                    }

                    override fun onCaptureFailed(
                        session: CameraCaptureSession,
                        request: CaptureRequest,
                        failure: CameraCaptureSession.CaptureFailure
                    ) {

                        status =
                            "CAPTURE FAILED: ${failure.reason}"
                    }
                },

                cameraHandler
            )

        } catch (e: Exception) {

            status =
                "CAPTURE ERROR: ${e.javaClass.simpleName}"

            e.printStackTrace()
        }
    }

    private fun saveJpeg(bytes: ByteArray) {

        try {

            val fileName =
                "AstroPad_${System.currentTimeMillis()}.jpg"

            val resolver = contentResolver

            val values =
                ContentValues().apply {

                    put(
                        MediaStore.Images.Media.DISPLAY_NAME,
                        fileName
                    )

                    put(
                        MediaStore.Images.Media.MIME_TYPE,
                        "image/jpeg"
                    )

                    if (Build.VERSION.SDK_INT >= 29) {

                        put(
                            MediaStore.Images.Media.RELATIVE_PATH,
                            Environment.DIRECTORY_PICTURES +
                            "/AstroPad Camera"
                        )

                        put(
                            MediaStore.Images.Media.IS_PENDING,
                            1
                        )
                    }
                }

            val uri: Uri? =
                resolver.insert(
                    MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
                    values
                )

            if (uri == null) {

                status = "ERROR: Could not create gallery file"

                return
            }

            resolver.openOutputStream(uri).use { output ->

                if (output == null) {

                    status = "ERROR: Could not open file"

                    return
                }

                output.write(bytes)
                output.flush()
            }

            if (Build.VERSION.SDK_INT >= 29) {

                val finished =
                    ContentValues().apply {

                        put(
                            MediaStore.Images.Media.IS_PENDING,
                            0
                        )
                    }

                resolver.update(
                    uri,
                    finished,
                    null,
                    null
                )
            }

            status =
                "✓ Saved to Pictures/AstroPad Camera"

        } catch (e: Exception) {

            status =
                "FILE ERROR: ${e.javaClass.simpleName}"

            e.printStackTrace()
        }
    }

    override fun onDestroy() {

        try {
            captureSession?.close()
        } catch (_: Exception) {
        }

        captureSession = null

        try {
            cameraDevice?.close()
        } catch (_: Exception) {
        }

        cameraDevice = null

        try {
            imageReader?.close()
        } catch (_: Exception) {
        }

        imageReader = null

        try {
            previewSurface?.release()
        } catch (_: Exception) {
        }

        previewSurface = null

        cameraThread.quitSafely()

        super.onDestroy()
    }
}

